 #include "SpellMgr.h"
 #include "Util.h"
 #include "World.h"
+#include "Config.h"
+#include "Creature.h"
+#include "Map.h"
+#include <algorithm>
+
+namespace
+{
+    // LOCAL (boss loot): extra loot rolls for dungeon/raid bosses. Chosen once per kill in Loot::FillLoot and applied
+    // to the top-level gear rolls in LootTemplate::Process (reference counts and plain group amounts). 1 = stock.
+    // Settings (worldserver.conf, read per boss kill so "reload config" applies them): BossLoot.Enable,
+    // BossLoot.Dungeon.MinRolls/MaxRolls, BossLoot.Raid.MinRolls/MaxRolls (clamped to 1..10).
+    thread_local uint32 s_bossLootRolls = 1;
+
+    uint32 BossLootRolls(WorldObject const* source)
+    {
+        Creature const* creature = source ? source->ToCreature() : nullptr;
+        if (!creature || !creature->GetMap() || !creature->GetMap()->IsDungeon())
+            return 1;
+        if (!creature->IsDungeonBoss() && !creature->isWorldBoss())
+            return 1;
+        if (!sConfigMgr->GetOption<bool>("BossLoot.Enable", false, false))
+            return 1;
+
+        bool const raid = creature->GetMap()->IsRaid();
+        uint32 const lo = sConfigMgr->GetOption<uint32>(raid ? "BossLoot.Raid.MinRolls" : "BossLoot.Dungeon.MinRolls",
+                                                        2, false);
+        uint32 const hi = sConfigMgr->GetOption<uint32>(raid ? "BossLoot.Raid.MaxRolls" : "BossLoot.Dungeon.MaxRolls",
+                                                        raid ? 2 : 4, false);
+        uint32 const minRolls = std::clamp<uint32>(lo, 1, 10);
+        return urand(minRolls, std::clamp<uint32>(hi, minRolls, 10));
+    }
+}
 
