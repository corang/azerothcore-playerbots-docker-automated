+bool HuhuranKeepWyvernSting(Player* bot, Unit* target)
+{
+    if (!bot || bot->GetMapId() != AQ40_MAP_ID || !target)
+        return false;
+    Player* const victim = target->ToPlayer();
+    if (!victim || PlayerbotAI::IsTank(victim))
+        return false;
+    return IsHuhuranEncounterActive(bot);
+}
