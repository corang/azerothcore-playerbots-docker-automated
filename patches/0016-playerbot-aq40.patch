@@ -0,0 +1,127 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#include "Aq40Multipliers.h"
+
+#include "Aq40CthunHelpers.h"
+#include "Aq40Helpers.h"
+#include "AttackAction.h"
+#include "CheckMountStateAction.h"
+#include "ChooseTargetActions.h"
+#include "FollowActions.h"
+#include "GenericSpellActions.h"
+#include "MovementActions.h"
+#include "Playerbots.h"
+#include "ReachTargetActions.h"
+#include "SpellInfo.h"
+#include "SpellMgr.h"
+
+using namespace TempleOfAhnQirajHelpers;
+
+float Aq40CthunMovementMultiplier::GetValue(Action* action)
+{
+    if (!action || bot->GetMapId() != AQ40_MAP_ID)
+        return 1.0f;
+
+    // Name exemptions first: each of these IS a MovementAction.
+    std::string const& name = action->getName();
+    if (name == "aq40 cthun exit stomach" || name == "aq40 cthun dodge glare" ||
+        name == "aq40 cthun clear beam" || name == "aq40 cthun form up" ||
+        name == "aq40 cthun run to far side" || name == "aq40 cthun drop to floor" ||
+        name == "aq40 cthun stomach close in")
+    {
+        return 1.0f;
+    }
+
+    // Bots copy a mounted master's mount state; during the fight that would remount them right after
+    // the dismount rule drops them. Riding IN is unaffected (they mounted before the pull).
+    if (dynamic_cast<CheckMountStateAction*>(action) && IsCthunEncounterActive(bot))
+        return 0.0f;
+
+    // The Eye/body have no useful back: "set behind" only walks melee around it out of range.
+    if (dynamic_cast<SetBehindTargetAction*>(action) && IsCthunEncounterActive(bot))
+        return 0.0f;
+
+    if (!bot->IsInCombat())
+        return 1.0f;
+
+    // Type test before the predicate. NEVER blanket-veto MovementAction: AttackAction and
+    // MeleeAction derive from it, and that would silence auto-attack.
+    bool const isFormationMover = dynamic_cast<CombatFormationMoveAction*>(action) ||
+                                  dynamic_cast<RearFlankAction*>(action);
+    bool const isReach = dynamic_cast<ReachTargetAction*>(action) != nullptr;
+    bool const isFollow = dynamic_cast<FollowAction*>(action) != nullptr;
+    if (!isFormationMover && !isReach && !isFollow)
+        return 1.0f;
+
+    // In the stomach, pathfinding-based reach can only fail (and waste the tick); the close-in
+    // action walks the bot into range instead.
+    if (isReach && IsInCthunStomach(bot))
+        return 0.0f;
+
+    return CthunShouldSuppressGenericMovement(bot, botAI) ? 0.0f : 1.0f;
+}
+
+float Aq40CthunTargetHoldMultiplier::GetValue(Action* action)
+{
+    if (!action || bot->GetMapId() != AQ40_MAP_ID)
+        return 1.0f;
+
+    // Exact classes, never AttackAction (MeleeAction and our focus action derive from it).
+    bool const isTargetChooser = dynamic_cast<DpsAssistAction*>(action) ||
+                                 dynamic_cast<DpsAoeAction*>(action) ||
+                                 dynamic_cast<TankAssistAction*>(action) ||
+                                 dynamic_cast<AggressiveTargetAction*>(action) ||
+                                 dynamic_cast<AttackAnythingAction*>(action) ||
+                                 dynamic_cast<AttackLeastHpTargetAction*>(action) ||
+                                 dynamic_cast<AttackRtiTargetAction*>(action);
+    if (!isTargetChooser)
+        return 1.0f;
+
+    if (!IsCthunEncounterActive(bot))
+        return 1.0f;
+
+    // Two separate reasons to veto: we have an opinion, or we are deliberately withholding.
+    if (GetCthunAttackTarget(bot, botAI))
+        return 0.0f;
+    return IsCthunHoldingFire(bot, botAI) ? 0.0f : 1.0f;
+}
+
+float Aq40CthunCastSafetyMultiplier::GetValue(Action* action)
+{
+    if (!action || bot->GetMapId() != AQ40_MAP_ID)
+        return 1.0f;
+
+    CastSpellAction* spellAction = dynamic_cast<CastSpellAction*>(action);
+    if (!spellAction || !IsCthunEncounterActive(bot))
+        return 1.0f;
+
+    // Cast time exactly as NaxxMultipliers' Heigan dance does it.
+    uint32 spellId = AI_VALUE2(uint32, "spell id", spellAction->getSpell());
+    SpellInfo const* spellInfo = sSpellMgr->GetSpellInfo(spellId);
+    if (!spellInfo)
+        return 1.0f;
+
+    uint32 castTime = spellInfo->CalcCastTime(bot);
+    if (spellInfo->IsChanneled())
+    {
+        int32 duration = spellInfo->GetDuration();
+        if (duration > 0)
+            castTime += uint32(duration);
+    }
+    if (castTime == 0)
+        return 1.0f;
+
+    if (CthunShouldClearBeam(bot))
+        return 0.0f;
+    // A cast stops the walk (walk, stop, cast, walk), so non-healers hold cast-time spells while
+    // forming up. Healers keep casting so the puller survives the opening beams.
+    if (!PlayerbotAI::IsHeal(bot) && CthunShouldFormUp(bot, botAI))
+        return 0.0f;
+    if (CthunGlareSecondsToHit(bot) * 1000.0f < float(castTime + CTHUN_GLARE_CAST_PAD_MS))
+        return 0.0f;
+    return 1.0f;
+}
diff --git a/modules/mod-playerbots/src/Ai/Raid/Aq40/Aq40Multipliers_Huhuran.cpp b/modules/mod-playerbots/src/Ai/Raid/Aq40/Aq40Multipliers_Huhuran.cpp
new file mode 100644
index 0000000..af3fd90
--- /dev/null
+++ b/modules/mod-playerbots/src/Ai/Raid/Aq40/Aq40Multipliers_Huhuran.cpp
@@ -0,0 +1,210 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+// Princess Huhuran multipliers (overlay patch 0016). Spec:
+// docs/superpowers/specs/2026-10-20-playerbot-aq40-huhuran-design.md (overlay repo), §4.2-4.3.
+
+#include "Aq40Multipliers.h"
+
+#include "Aq40Helpers.h"
+#include "AttackAction.h"
+#include "ChooseTargetActions.h"
+#include "EncounterHelpers.h"
+#include "FollowActions.h"
+#include "GenericSpellActions.h"
+#include "HunterActions.h"
+#include "MovementActions.h"
+#include "Playerbots.h"
+#include "ReachTargetActions.h"
+
+#include <string>
+#include <unordered_set>
+
+using namespace TempleOfAhnQirajHelpers;
+
+namespace
+{
+    bool IsHuhuranAction(Action* action) { return action->getName().rfind("aq40 huhuran", 0) == 0; }
+}
+
+// The C'Thun in-combat mover set (Aq40CthunMovementMultiplier). Type tests before any view lookup: this runs
+// for every queued action of every bot on every tick. NEVER blanket-veto MovementAction: AttackAction and
+// MeleeAction derive from it, and that would silence auto-attack.
+float Aq40HuhuranMovementMultiplier::GetValue(Action* action)
+{
+    if (!action || bot->GetMapId() != AQ40_MAP_ID || IsHuhuranAction(action))
+        return 1.0f;
+
+    bool const isGenericMover = dynamic_cast<CombatFormationMoveAction*>(action) ||
+                                dynamic_cast<RearFlankAction*>(action) ||
+                                dynamic_cast<ReachTargetAction*>(action) || dynamic_cast<FollowAction*>(action);
+    if (!isGenericMover)
+        return 1.0f;
+
+    HuhuranView view;
+    if (!GetHuhuranView(bot, view))
+        return 1.0f;
+
+    // A ring holder, on its spot OR still walking to it: the veto must not fail open while travelling, or
+    // follow/formation pulls it off course every tick.
+    Position spot;
+    if (GetHuhuranSpot(bot, botAI, view, spot))
+        return 0.0f;
+
+    // An off-tank with a melee spot beside the MT (rev 2, spec §7.2 #3), on it or walking to it: "aq40 huhuran
+    // off tank engage" owns its movement. Never while the opener hold runs (no spot is used then).
+    if (PlayerbotAI::IsTank(bot) && bot != view.mainTank && !HuhuranOpenerHold(view) &&
+        GetHuhuranOffTankSpot(bot, view, spot))
+        return 0.0f;
+
+    // The MT holds position once she is parked (rev 7, spec §12.2 #2): stock "tank face" put her back to the
+    // raid, but the rings surround her, so pull 6's MT circled her (834 runs, 24 moves). "aq40 huhuran park
+    // boss" turns it in place instead. Unparked, it owns its movement while it has work (the drag).
+    if (bot == view.mainTank &&
+        (view.parked || GetHuhuranMtStep(bot, view, AI_VALUE(Unit*, "current target")) != HuhuranMtStep::None))
+        return 0.0f;
+
+    return 1.0f;
+}
+
+// The opener hold (rev 2, spec §7.2 #1): the Nefarian hold-fire set (BwlNefarianMultiplier) - the generic target
+// choosers plus the melee / auto-shot / wand starters - and, for a bot already on her, its threat-bearing
+// non-heal actions. Non-tank bots only, until she has been parked once this attempt. Time-bounded by
+// HoldFireOnHuhuran's 45 s fail-open, so this is never a permanent targeting veto.
+float Aq40HuhuranTargetHoldMultiplier::GetValue(Action* action)
+{
+    if (!action || bot->GetMapId() != AQ40_MAP_ID || IsHuhuranAction(action))
+        return 1.0f;
+
+    // Exact classes, never AttackAction (MeleeAction and our own actions derive from it).
+    bool const isTargetChooser = dynamic_cast<DpsAssistAction*>(action) ||
+                                 dynamic_cast<DpsAoeAction*>(action) ||
+                                 dynamic_cast<TankAssistAction*>(action) ||
+                                 dynamic_cast<AggressiveTargetAction*>(action) ||
+                                 dynamic_cast<AttackAnythingAction*>(action) ||
+                                 dynamic_cast<AttackLeastHpTargetAction*>(action) ||
+                                 dynamic_cast<AttackRtiTargetAction*>(action);
+    bool const isAutoAttack = dynamic_cast<MeleeAction*>(action) || dynamic_cast<CastAutoShotAction*>(action) ||
+                              dynamic_cast<CastShootAction*>(action);
+    // Heals are Aoe-typed (CastHealingSpellAction) and never held.
+    bool const isThreatAction = action->getThreatType() != Action::ActionThreatType::None &&
+                                !dynamic_cast<CastHealingSpellAction*>(action);
+    if (!isTargetChooser && !isAutoAttack && !isThreatAction)
+        return 1.0f;
+    if (PlayerbotAI::IsTank(bot))
+        return 1.0f;
+
+    // Attack starters and threat actions are held only against her: cheap entry test before the view.
+    Unit* current = nullptr;
+    if (!isTargetChooser)
+    {
+        current = AI_VALUE(Unit*, "current target");
+        if (!current || current->GetEntry() != NPC_HUHURAN)
+            return 1.0f;
+    }
+
+    HuhuranView view;
+    if (!GetHuhuranView(bot, view) || !HuhuranOpenerHold(view))
+        return 1.0f;
+
+    // She is the only hostile in her room: every generic chooser would hand her straight back.
+    if (isTargetChooser)
+        return 0.0f;
+    return current == view.huhuran ? 0.0f : 1.0f;
+}
+
+// Taunt-immune (spec §4.2): a taunt at her is a wasted GCD for any tank. Copied from BWL's Nefarian veto
+// (BwlNefarianMultiplier): taunt-type actions (EncounterHelpers::IsTauntAction, tanks only) while she is the
+// current target. Encounter only: the view gate fails outside it.
+float Aq40HuhuranTauntMultiplier::GetValue(Action* action)
+{
+    if (!action || bot->GetMapId() != AQ40_MAP_ID || !EncounterHelpers::IsTauntAction(bot, action))
+        return 1.0f;
+
+    Unit* const current = AI_VALUE(Unit*, "current target");
+    if (!current || current->GetEntry() != NPC_HUHURAN)
+        return 1.0f;
+
+    HuhuranView view;
+    if (!GetHuhuranView(bot, view))
+        return 1.0f;
+    return current == view.huhuran ? 0.0f : 1.0f;
+}
+
+// Rev 2 (spec §7.2 #2): threat discipline after the opener hold, mirroring BwlThreatDisciplineMultiplier
+// (copied, not called): the same veto set - every threat-typed action plus the exact auto-attack restarters
+// (MeleeAction, CastAutoShotAction, CastShootAction, none of which has a subclass), heals never - against
+// her only, for DPS and off-tanks (HuhuranThreatDisciplined: not a healer, not the MT). Order MT > backup > DPS
+// (fix round 1, R11, the Nefarian rule): off-tanks against the MT's threat at 1.00 (rev 3, §8.2 #3), DPS
+// against the top living off-tank's (fallback the MT's) at 0.80; veto at own + 1500 >= ratio x denominator,
+// plus upstream's AoE rule. In Berserk all go against the MT with no headroom: off-tanks 1.05, DPS 1.00 (rev 5
+// §10.3, R14). No cap when the denominator is 0. Cheap type, role and target tests before the view: this runs
+// for every queued action of every bot on every tick.
+float Aq40HuhuranThreatMultiplier::GetValue(Action* action)
+{
+    if (!action || bot->GetMapId() != AQ40_MAP_ID || IsHuhuranAction(action))
+        return 1.0f;
+
+    Action::ActionThreatType const threatType = action->getThreatType();
+    bool const isAutoAttack = dynamic_cast<MeleeAction*>(action) || dynamic_cast<CastAutoShotAction*>(action) ||
+                              dynamic_cast<CastShootAction*>(action);
+    if (threatType == Action::ActionThreatType::None && !isAutoAttack)
+        return 1.0f;
+    // Heals are Aoe-typed (CastHealingSpellAction) and must never be limited, whoever casts them.
+    if (dynamic_cast<CastHealingSpellAction*>(action) || PlayerbotAI::IsHeal(bot))
+        return 1.0f;
+    if (AI_VALUE(bool, "neglect threat"))
+        return 1.0f;
+
+    Unit* const current = AI_VALUE(Unit*, "current target");
+    if (!current || current->GetEntry() != NPC_HUHURAN)
+        return 1.0f;
+
+    HuhuranView view;
+    if (!GetHuhuranView(bot, view) || current != view.huhuran || !HuhuranThreatDisciplined(bot, view))
+        return 1.0f;
+    float const denom = HuhuranThreatDenominator(bot, view);
+    if (denom <= 0.0f)
+        return 1.0f;  // no tank threat on her to protect: no cap
+
+    bool const veto = (threatType == Action::ActionThreatType::Aoe && AI_VALUE2(uint8, "threat", "aoe") >= 50) ||
+                      HuhuranThreatVetoed(bot, view);
+    return veto ? 0.0f : 1.0f;
+}
+
+// Rev 3 (spec §8.2 #1): offensive, raid, racial, trinket and tank cooldowns are held for Berserk. Pull 2 spent
+// every one between 20 and 90 s (the stock boost triggers have no phase input) and the MT had nothing left
+// when she went berserk. Exact registered action names (each checked against its context creator / Action
+// constructor); each bot's own strategies decide which it actually has. Mana cooldowns (innervate, mana tide,
+// potions, healthstone) and heals are deliberately absent. Bots only (not selfbots); 1.0 whenever the view
+// is inert or Berserk is up, so the stock triggers then fire them as usual.
+float Aq40HuhuranCooldownHoldMultiplier::GetValue(Action* action)
+{
+    static std::unordered_set<std::string> const kHeld = {
+        // DPS cooldowns
+        "death wish", "recklessness", "blade flurry", "adrenaline rush", "arcane power", "icy veins", "combustion",
+        "presence of mind", "mirror image", "rapid fire", "bestial wrath", "elemental mastery", "power infusion",
+        "avenging wrath", "divine favor", "berserk", "cold blood",
+        // raid cooldowns
+        "bloodlust", "heroism",
+        // racials
+        "blood fury", "berserking",
+        // trinkets
+        "use trinket",
+        // tank defensives. barkskin / divine protection (rev 3 fix round 1, R13): a bear MT's stock "almost full
+        // health" barkskin fired every ~60 s, so it was on cooldown at Berserk and the MT defensive could not fire.
+        "shield wall", "last stand", "every man for himself", "barkskin", "divine protection"};
+
+    if (!action || bot->GetMapId() != AQ40_MAP_ID || IsSelfBot(bot))
+        return 1.0f;
+    if (!kHeld.count(action->getName()))
+        return 1.0f;
+
+    HuhuranView view;
+    if (!GetHuhuranView(bot, view) || view.berserk)
+        return 1.0f;
+    return 0.0f;
+}
diff --git a/modules/mod-playerbots/src/Ai/Raid/Aq40/Aq40Strategy.cpp b/modules/mod-playerbots/src/Ai/Raid/Aq40/Aq40Strategy.cpp
new file mode 100644
index 0000000..a926e4f
--- /dev/null
+++ b/modules/mod-playerbots/src/Ai/Raid/Aq40/Aq40Strategy.cpp
@@ -0,0 +1,182 @@
+/*
+ * This file is part of the mod-playerbots module for AzerothCore. See AUTHORS file for Copyright
+ * information; released under GNU GPL v2 license, redistribute/modify under version 2 of the License,
+ * or (at your option) any later version.
+ */
+
+#include "Aq40Strategy.h"
+
+#include "Aq40Helpers.h"
+#include "Aq40CthunHelpers.h"
+#include "Aq40Multipliers.h"
+#include "Playerbots.h"
+
+// Relevances are set against how OFTEN each competitor fires, not just how urgent it is: an
+// always-active action starves anything ranked under it. ACTION_RAID is 60, ACTION_EMERGENCY 90.
+void RaidAq40Strategy::InitTriggers(std::vector<TriggerNode*>& triggers)
+{
+    // Housekeeping, and harmless: only fires out of combat with the encounter not running.
+    triggers.push_back(new TriggerNode("aq40 twins not in combat", {
+        NextAction("aq40 twins erase trackers", ACTION_EMERGENCY + 11) }));
+
+    // ~3000 fire in 15y on a 3s fuse - the only mechanic here with a hard clock.
+    triggers.push_back(new TriggerNode("aq40 twins in explode radius", {
+        NextAction("aq40 twins clear explode", ACTION_EMERGENCY + 4) }));
+
+    // ~1500 per 2s in 10y plus a -30% slow.
+    triggers.push_back(new TriggerNode("aq40 twins in blizzard", {
+        NextAction("aq40 twins clear blizzard", ACTION_EMERGENCY + 3) }));
+
+    // Above generic target selection so bots actually switch to a Mutated Bug (+300% health,
+    // +1800% physical damage, 240s), below the movement emergencies because dying while dutifully
+    // retargeting is a poor trade.
+    triggers.push_back(new TriggerNode("aq40 twins wrong target", {
+        NextAction("aq40 twins focus target", ACTION_EMERGENCY + 1) }));
+
+    // Heal Brother is the one thing that makes the encounter unwinnable rather than merely hard,
+    // so it outranks ordinary positioning - but its own predicate stands down while the bot owes
+    // a hazard move, so the two can never trade the same tank back and forth.
+    triggers.push_back(new TriggerNode("aq40 twins too close", {
+        NextAction("aq40 twins separate twins", ACTION_RAID + 4) }));
+
+    // The tank swap: toward the twin I hold, away from the one I do not.
+    triggers.push_back(new TriggerNode("aq40 twins tank out of position", {
+        NextAction("aq40 twins position tank", ACTION_RAID + 3) }));
+
+    triggers.push_back(new TriggerNode("aq40 twins healer off spot", {
+        NextAction("aq40 twins hold healer spot", ACTION_RAID + 2) }));
+
+    // Lowest of the family, so it cannot starve anything.
+    triggers.push_back(new TriggerNode("aq40 twins pet on wrong twin", {
+        NextAction("aq40 twins direct pets", ACTION_RAID + 1) }));
+
+    // NOTE what is absent: anything that moves DPS. Their assigned twin is their target and native
+    // combat movement walks them to it, across the room after a teleport if that is where it went.
+    // Authoring stations for them was the previous revision's central mistake.
+
+    // ---- C'Thun ----
+    // The two encounters never run at once, so relevance values overlapping the Twins ones are fine.
+
+    triggers.push_back(new TriggerNode("aq40 cthun not in combat", {
+        NextAction("aq40 cthun erase trackers", ACTION_EMERGENCY + 11) }));
+
+    // Bots cannot fire the client-side exit trigger; this walks them there and sends it.
+    triggers.push_back(new TriggerNode("aq40 cthun in stomach", {
+        NextAction("aq40 cthun exit stomach", ACTION_EMERGENCY + 6) }));
+
+    // Bots get no client gravity: the swallow and the stomach exit leave them hovering, and a fall's
+    // FALLING flag never clears (every cast-time spell fails). Teleport down / scrub the flag.
+    // Bots ride in with a mounted master; once in place they must dismount to fight.
+    triggers.push_back(new TriggerNode("aq40 cthun mounted in place", {
+        NextAction("aq40 cthun dismount", ACTION_EMERGENCY + 8) }));
+
+    triggers.push_back(new TriggerNode("aq40 cthun stomach airborne", {
+        NextAction("aq40 cthun drop to floor", ACTION_EMERGENCY + 7) }));
+
+    // ~50k per tick, 5y either side of the Eye's facing, unlimited range.
+    triggers.push_back(new TriggerNode("aq40 cthun in glare path", {
+        NextAction("aq40 cthun dodge glare", ACTION_EMERGENCY + 5) }));
+
+    // Break the Green Beam chain at its source during the 2s cast.
+    triggers.push_back(new TriggerNode("aq40 cthun near beam target", {
+        NextAction("aq40 cthun clear beam", ACTION_EMERGENCY + 4) }));
+
+    // The Eye's first four beams all go to the puller; it drags them to the far side so the raid
+    // can spread.
+    triggers.push_back(new TriggerNode("aq40 cthun opening puller", {
+        NextAction("aq40 cthun run to far side", ACTION_EMERGENCY + 3) }));
+
+    // Stomach: walk into range of the Flesh Tentacle (pathfinding reach fails in there). Below
+    // "focus target" so the target is chosen first.
+    triggers.push_back(new TriggerNode("aq40 cthun stomach far from tentacle", {
+        NextAction("aq40 cthun stomach close in", ACTION_EMERGENCY) }));
+
+    // Below the hazard moves: dying while dutifully retargeting is a poor trade.
+    triggers.push_back(new TriggerNode("aq40 cthun wrong target", {
+        NextAction("aq40 cthun focus target", ACTION_EMERGENCY + 1) }));
+
+    // FIXED spots, spaced >= 12y by construction: everyone returns to their own spot whenever off it
+    // (melee stage off the puller's lane until its 4th beam has landed). No disperse.
+    triggers.push_back(new TriggerNode("aq40 cthun not formed", {
+        NextAction("aq40 cthun form up", ACTION_RAID + 3) }));
+
+    // ---- Huhuran ----
+    // Spec docs/superpowers/specs/2026-10-20-playerbot-aq40-huhuran-design.md (overlay repo), §4.2-4.3.
+
+    triggers.push_back(new TriggerNode("aq40 huhuran not in combat", {
+        NextAction("aq40 huhuran erase trackers", ACTION_EMERGENCY + 11) }));
+
+    // The MT's drag onto P: close, take her, back her toward T while she is on it and not parked.
+    triggers.push_back(new TriggerNode("aq40 huhuran mt has work", {
+        NextAction("aq40 huhuran park boss", ACTION_RAID + 4) }));
+
+    // Stock off-tanks idle while she is on the MT (FindTargetForTankStrategy); she is taunt-immune, so
+    // backup threat must be built by attacking. Rev 2 (spec §7.2 #3): also walks each off-tank to its melee
+    // spot beside the MT, so an MT death leaves her turning to a body where the MT stood.
+    triggers.push_back(new TriggerNode("aq40 huhuran off tank idle", {
+        NextAction("aq40 huhuran off tank engage", ACTION_RAID + 3) }));
+
+    // Ring spots, latched at engage (rev 4, spec §9.2): ranged and healers form the rings while the MT drags.
+    triggers.push_back(new TriggerNode("aq40 huhuran off spot", {
+        NextAction("aq40 huhuran hold spot", ACTION_RAID + 3) }));
+
+    // Rev 2 (spec §7.2 #2): the threat hard stop, at BWL's "bwl threat hold" relevance. The multiplier's
+    // vetoes cannot stop an auto-attack or auto-shot that is already running. Healers are never active.
+    triggers.push_back(new TriggerNode("aq40 huhuran threat hold", {
+        NextAction("aq40 huhuran threat hold", ACTION_RAID + 1) }));
+
+    // Rev 2 (spec §7.2 #4): Berserk tank healers. BWL's tank-only priest heal sits at ACTION_RAID + 1, which
+    // is above every stock heal (ACTION_CRITICAL_HEAL 30 and its +N rows); below the hold-spot row so a
+    // displaced tank healer walks back first. Healers are never active on the threat hold, so the two
+    // rows never compete.
+    triggers.push_back(new TriggerNode("aq40 huhuran tank heal", {
+        NextAction("aq40 huhuran tank heal", ACTION_RAID + 1) }));
+
+    // Rev 3 (spec §8.2 #2): the MT's Berserk defensive outranks the park/threat rows (and its own rotation):
+    // pull 2's MT died within ~5 s of Berserk. Off-GCD or instant, so it costs the tank rotation one tick.
+    triggers.push_back(new TriggerNode("aq40 huhuran mt berserk defensive", {
+        NextAction("aq40 huhuran mt berserk defensive", ACTION_EMERGENCY) }));
+
+    LOG_DEBUG("playerbots", "[Aq40Cthun] strategy loaded: cthun={} eye={} exitAT={} acidExit={}",
+              TempleOfAhnQirajHelpers::AQT_DATA_CTHUN,
+              TempleOfAhnQirajHelpers::AQT_DATA_EYE_OF_CTHUN,
+              TempleOfAhnQirajHelpers::AT_CTHUN_STOMACH_EXIT,
+              TempleOfAhnQirajHelpers::CTHUN_ACID_EXIT_STACKS);
+
+    LOG_DEBUG("playerbots",
+              "[Aq40Twins] strategy loaded: twins={} veklor={} veknilash={} kiteTo={:.0f} "
+              "engage={:.0f} guard={:.0f}",
+              TempleOfAhnQirajHelpers::AQT_DATA_TWIN_EMPERORS,
+              TempleOfAhnQirajHelpers::AQT_DATA_VEKLOR,
+              TempleOfAhnQirajHelpers::AQT_DATA_VEKNILASH,
+              TempleOfAhnQirajHelpers::TWINS_SEAT_SEPARATION,
+              TempleOfAhnQirajHelpers::TWINS_TANK_ENGAGE_RANGE,
+              TempleOfAhnQirajHelpers::TWINS_SEPARATION_GUARD);
+
+    LOG_DEBUG("playerbots", "[Aq40Huhuran] strategy loaded: huhuran={} npc={} park=({:.1f},{:.1f})",
+              TempleOfAhnQirajHelpers::AQT_DATA_HUHURAN,
+              TempleOfAhnQirajHelpers::NPC_HUHURAN,
+              TempleOfAhnQirajHelpers::HUHURAN_PARK.GetPositionX(),
+              TempleOfAhnQirajHelpers::HUHURAN_PARK.GetPositionY());
+    if constexpr (TempleOfAhnQirajHelpers::HUHURAN_STATIONS_PROVISIONAL)
+        LOG_WARN("playerbots", "[Aq40Huhuran] park/MT stations are PROVISIONAL (patrol centroid): the Huhuran "
+                               "strategy is INERT (only the Wyvern Sting dispel rule runs) until they are authored "
+                               "with tools/aq40-huhuran-stations.py");
+}
+
+void RaidAq40Strategy::InitMultipliers(std::vector<Multiplier*>& multipliers)
+{
+    // BOTH ship in the first cut. Shipping the target-hold veto later cost the previous attempt
+    // four revisions.
+    multipliers.push_back(new TwinEmperorsMovementMultiplier(botAI));
+    multipliers.push_back(new TwinEmperorsTargetHoldMultiplier(botAI));
+    multipliers.push_back(new Aq40CthunMovementMultiplier(botAI));
+    multipliers.push_back(new Aq40CthunTargetHoldMultiplier(botAI));
+    multipliers.push_back(new Aq40CthunCastSafetyMultiplier(botAI));
+    // ---- Huhuran ----
+    multipliers.push_back(new Aq40HuhuranMovementMultiplier(botAI));
+    multipliers.push_back(new Aq40HuhuranTargetHoldMultiplier(botAI));
+    multipliers.push_back(new Aq40HuhuranTauntMultiplier(botAI));
+    multipliers.push_back(new Aq40HuhuranThreatMultiplier(botAI));
+    multipliers.push_back(new Aq40HuhuranCooldownHoldMultiplier(botAI));
+}
