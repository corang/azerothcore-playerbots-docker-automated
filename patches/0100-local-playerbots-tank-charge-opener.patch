index 092b423e..67dc9ba6 100644
--- a/modules/mod-playerbots/src/Ai/Class/Warrior/WarriorActions.cpp
+++ b/modules/mod-playerbots/src/Ai/Class/Warrior/WarriorActions.cpp
@@ -232,3 +232,20 @@ bool CastShatteringThrowAction::isPossible()
     // If the minimal checks above pass, simply return true.
     return true;
 }
+
+// LOCAL: Charge needs Battle Stance and no combat (until Warbringer). From another stance the core rejects it as
+// ONLY_SHAPESHIFT, so the engine never reached the node's "battle stance" prerequisite. Out of combat, in charge
+// range and in sight, report it possible so the stance swap runs first; everything else keeps the normal check.
+bool CastChargeAction::isPossible()
+{
+    if (bot->IsInCombat() || botAI->HasAura("battle stance", bot) || botAI->HasAura("warbringer", bot))
+        return CastReachTargetSpellAction::isPossible();
+
+    Unit* target = GetTarget();
+    uint32 const spellId = AI_VALUE2(uint32, "spell id", "charge");
+    if (!target || !spellId || bot->HasSpellCooldown(spellId) || !bot->IsWithinLOSInMap(target))
+        return false;
+
+    float const distance = bot->GetDistance(target);
+    return distance >= 8.0f && distance <= 24.0f;
+}
