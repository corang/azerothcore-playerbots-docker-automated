+            NefClock& clock = g_nefClock[instanceId];
+            if (clock.diagMs && getMSTimeDiff(clock.diagMs, now) < NEF_DIAG_INTERVAL_MS)
+                return false;
+            clock.diagMs = now;
+            return true;
+        }
