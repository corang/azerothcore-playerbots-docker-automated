+// LOCAL (0102): the tree a premade spec mostly spends in — talent points per tab in its final (highest-level) link —
+// for era-talent bots, whose builds are chosen per tree.
+static int PremadeSpecTab(int cls, int specNo)
+{
+    for (int level = MAX_LEVEL - 1; level >= 0; --level)
+    {
+        std::vector<std::vector<uint32>> const& picks = sPlayerbotAIConfig.ParsedSpecLinkOrder[cls][specNo][level];
+        if (picks.empty())
+            continue;
+
+        uint32 points[3] = {0, 0, 0};
+        for (std::vector<uint32> const& pick : picks)
+            if (pick.size() >= 4 && pick[0] < 3)
+                points[pick[0]] += pick[3];
+        return int(std::max_element(points, points + 3) - points);
+    }
+    return 0;
+}
